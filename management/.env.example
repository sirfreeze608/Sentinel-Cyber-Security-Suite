# Sentinel Management Server Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Flask secret key (change in production!)
SENTINEL_SECRET_KEY=dev-secret-change-in-production

# Database URL (default SQLite in management folder)
SENTINEL_DB_URL=sqlite:///sentinel_mgmt.db

# Server bind settings
SENTINEL_MGMT_HOST=0.0.0.0
SENTINEL_MGMT_PORT=8000
SENTINEL_MGMT_DEBUG=false

# Default agent registration token
SENTINEL_DEFAULT_AGENT_TOKEN=sentinel-agent-token-change-me
