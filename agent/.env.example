# Sentinel Agent Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# VirusTotal API Key (get free key at https://www.virustotal.com/gui/join)
VT_API_KEY=your_virustotal_api_key_here

# Sentinel Management Server (CS Department dashboard)
SENTINEL_MGMT_URL=http://127.0.0.1:8000
SENTINEL_AGENT_TOKEN=sentinel-agent-token-change-me
SENTINEL_AGENT_ID=
